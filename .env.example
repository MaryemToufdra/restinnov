APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Values below target the Docker Compose stack (see docker-compose.yml and
# README-DOCKER.md): "db" is the MySQL service's hostname on the compose
# network, and the credentials match the "db" service's environment there.
# For a non-Docker local setup, switch back to DB_CONNECTION=sqlite (no
# other DB_* value is needed in that case).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=restinnov
DB_USERNAME=restinnov
DB_PASSWORD=restinnov

# Default manager account, created by ManagerAccountSeeder on first deploy
# (see README-DOCKER.md "Comptes & connexion"). Change these before a real
# deployment, and change the password again after first login.
MANAGER_DEFAULT_TELEPHONE=0600000000
MANAGER_DEFAULT_PASSWORD=ChangeMe123!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
